{
  "name": "ventanilla-posgrado",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "node scripts/prisma-provider.mjs && prisma generate",
    "db:provider": "node scripts/prisma-provider.mjs",
    "db:push": "npm run db:provider && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "npm run db:provider && prisma db push --skip-generate && prisma generate && npm run db:seed",
    "setup": "npm run db:reset",
    "vercel-build": "node scripts/prisma-provider.mjs && prisma generate && prisma db push --skip-generate && tsx prisma/seed.ts --si-vacia && next build",
    "test:e2e": "playwright test",
    "neon:env": "neon env pull --file .env.neon",
    "neon:setup": "node scripts/con-neon.mjs \"node scripts/prisma-provider.mjs && prisma generate && prisma db push --skip-generate && tsx prisma/seed.ts\"",
    "neon:build": "node scripts/con-neon.mjs \"node scripts/prisma-provider.mjs && prisma generate && next build\"",
    "neon:start": "node scripts/con-neon.mjs \"next start\"",
    "db:sqlite": "node scripts/prisma-provider.mjs && prisma generate"
  },
  "dependencies": {
    "@neon/config": "^1.9.6",
    "@neon/env": "^1.6.6",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@vercel/functions": "^3.10.5",
    "bcryptjs": "^3.0.3",
    "d3-geo": "^3.1.1",
    "jose": "^6.2.14",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
